{
  "info": {
    "name": "Nightscout Clock Device API",
    "description": "Requests for the HTTP API exposed by the Nightscout Clock firmware. Set baseUrl to the device origin (for example http://192.168.1.50). When web authentication is enabled, run Login first; Postman stores and sends the auth_token cookie. Some requests are build- or glucose-source-dependent. Restart, factory reset, configuration save, and reading deletion change device state.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get auth status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/status",
            "description": "No authentication required."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.expect([200]).to.include(pm.response.code))"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{webAuthPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Stores the auth_token cookie in Postman when authentication is enabled."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.expect([200, 400, 401]).to.include(pm.response.code))"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requires a valid auth_token cookie when authentication is enabled."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.expect([200, 401]).to.include(pm.response.code))"
                ]
              }
            }
          ]
        }
      ]
    },
