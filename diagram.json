{
    "version": 1,
    "author": "NSClock",
    "editor": "wokwi",
    "parts": [
        { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
        {
            "type": "wokwi-neopixel-canvas",
            "id": "neopixels",
            "top": -150,
            "left": -100,
            "attrs": { "rows": "8", "cols": "32" }
        },
        {
            "type": "wokwi-pushbutton",
            "id": "btn_left",
            "top": 260,
            "left": -120,
            "attrs": { "color": "blue", "label": "Left (26)", "bounce": "0" }
        },
        {
            "type": "wokwi-pushbutton",
            "id": "btn_select",
            "top": 260,
            "left": 0,
            "attrs": { "color": "green", "label": "Select (27)", "bounce": "0" }
        },
        {
            "type": "wokwi-pushbutton",
            "id": "btn_right",
            "top": 260,
            "left": 120,
            "attrs": { "color": "blue", "label": "Right (14)", "bounce": "0" }
        },
        {
            "type": "wokwi-photoresistor-sensor",
            "id": "ldr",
            "top": 40,
            "left": 220,
            "attrs": {}
        },
        {
            "type": "wokwi-buzzer",
            "id": "buzzer",
            "top": -60,
            "left": 220,
            "attrs": { "volume": "0.1" }
        }
    ],
    "connections": [
        [ "esp:TX", "$serialMonitor:RX", "", [] ],
        [ "esp:RX", "$serialMonitor:TX", "", [] ],

        [ "neopixels:DIN", "esp:32", "green", [] ],
        [ "neopixels:VDD", "esp:5V", "red", [] ],
        [ "neopixels:VSS", "esp:GND.1", "black", [] ],

        [ "btn_left:1.l", "esp:26", "blue", [] ],
        [ "btn_left:2.l", "esp:GND.1", "black", [] ],
        [ "btn_select:1.l", "esp:27", "green", [] ],
        [ "btn_select:2.l", "esp:GND.1", "black", [] ],
        [ "btn_right:1.l", "esp:14", "blue", [] ],
        [ "btn_right:2.l", "esp:GND.1", "black", [] ],

        [ "ldr:AO", "esp:35", "orange", [] ],
        [ "ldr:VCC", "esp:3V3", "red", [] ],
        [ "ldr:GND", "esp:GND.2", "black", [] ],

        [ "buzzer:2", "esp:15", "red", [] ],
        [ "buzzer:1", "esp:GND.3", "black", [] ]
    ],
    "dependencies": {}
}
